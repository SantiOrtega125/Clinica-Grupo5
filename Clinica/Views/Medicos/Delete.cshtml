@model Clinica.Models.Medico

@{
    ViewData["Title"] = "Eliminar médico";
}

<h1>Eliminar médico</h1>

<h3>¿Seguro que desea eliminar este médico?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroLicencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NumeroLicencia)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AniosExperiencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AniosExperiencia)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Especialidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Especialidad!.Nombre)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>