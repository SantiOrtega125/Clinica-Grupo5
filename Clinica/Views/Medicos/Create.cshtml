@model Clinica.Models.Medico

@{
    ViewData["Title"] = "Registrar médico";
}

<h1>Registrar médico</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumeroLicencia" class="control-label"></label>
                <input asp-for="NumeroLicencia" class="form-control" />
                <span asp-validation-for="NumeroLicencia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AniosExperiencia" class="control-label"></label>
                <input asp-for="AniosExperiencia" class="form-control" />
                <span asp-validation-for="AniosExperiencia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EspecialidadId" class="control-label"></label>
                <select asp-for="EspecialidadId" class="form-control" asp-items="ViewBag.EspecialidadId">
                    <option value="">-- Seleccione una especialidad --</option>
                </select>
                <span asp-validation-for="EspecialidadId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}