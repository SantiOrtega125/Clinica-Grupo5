@model Clinica.Models.Medico

@{
    ViewData["Title"] = "Detalle del médico";
}

<h1>Detalle del médico</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroLicencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NumeroLicencia)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AniosExperiencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AniosExperiencia)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Especialidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Especialidad!.Nombre)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Director"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a>
        <span> | </span>
    }
    <a asp-action="Index">Volver a la lista</a>
</div>