@model IEnumerable<Clinica.Models.Medico>

@{
    ViewData["Title"] = "Médicos";
}

<h1>Directorio de médicos</h1>

@if (User.IsInRole("Director"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Registrar médico</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumeroLicencia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AniosExperiencia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Especialidad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.NumeroLicencia)
                </td>
                <td>
                    @Html.DisplayFor(model => item.AniosExperiencia)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Especialidad!.Nombre)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                    @if (User.IsInRole("Director"))
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>